<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Observer Category -->
    <record id="category_incipient_observer" model="ir.module.category">
        <field name="name">Incipient Observer Roles</field>
        <field name="description">Read-only auditor and observer roles for Sales and Purchasing</field>
        <field name="sequence">90</field>
    </record>

    <!-- Sales Observer Privilege & Group -->
    <record id="privilege_sale_observer" model="res.groups.privilege">
        <field name="name">Sales Observer</field>
        <field name="category_id" ref="category_incipient_observer"/>
    </record>

    <record id="group_sale_observer" model="res.groups">
        <field name="name">Sales Observer (Read-Only)</field>
        <field name="privilege_id" ref="privilege_sale_observer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Grants read-only access to Sales quotations and orders, related pickings, invoices, and BOMs without create, edit, or delete permissions.</field>
    </record>

    <!-- Purchase Observer Privilege & Group -->
    <record id="privilege_purchase_observer" model="res.groups.privilege">
        <field name="name">Purchase Observer</field>
        <field name="category_id" ref="category_incipient_observer"/>
    </record>

    <record id="group_purchase_observer" model="res.groups">
        <field name="name">Purchase Observer (Read-Only)</field>
        <field name="privilege_id" ref="privilege_purchase_observer"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Grants read-only access to Purchase RFQs and orders, related receipts, vendor bills, and BOMs without create, edit, or delete permissions.</field>
    </record>

    <!-- Record rules for Sales Observer -->
    <record id="rule_sale_order_observer" model="ir.rule">
        <field name="name">Sales Order: Observer Read-Only</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="groups" eval="[(4, ref('group_sale_observer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_sale_order_line_observer" model="ir.rule">
        <field name="name">Sales Order Line: Observer Read-Only</field>
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="groups" eval="[(4, ref('group_sale_observer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Record rules for Purchase Observer -->
    <record id="rule_purchase_order_observer" model="ir.rule">
        <field name="name">Purchase Order: Observer Read-Only</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="groups" eval="[(4, ref('group_purchase_observer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="rule_purchase_order_line_observer" model="ir.rule">
        <field name="name">Purchase Order Line: Observer Read-Only</field>
        <field name="model_id" ref="purchase.model_purchase_order_line"/>
        <field name="groups" eval="[(4, ref('group_purchase_observer'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!-- Menu visibility bindings -->
    <record id="purchase.menu_purchase_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_purchase_observer'))]"/>
    </record>

    <record id="sale.sale_menu_root" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_sale_observer'))]"/>
    </record>

    <record id="sale.sale_order_menu" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_sale_observer'))]"/>
    </record>

    <record id="sale.menu_sale_quotations" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_sale_observer'))]"/>
    </record>

    <record id="sale.product_menu_catalog" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_sale_observer'))]"/>
    </record>

    <record id="sale.menu_sale_invoicing" model="ir.ui.menu">
        <field name="group_ids" eval="[(4, ref('group_sale_observer'))]"/>
    </record>
</odoo>
