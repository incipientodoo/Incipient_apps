<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="edit_project_inherit_receipt_timer" model="ir.ui.view">
        <field name="name">project.project.form.inherit.receipt.timer</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_tasks_managment']/div" position="inside">
                <setting class="col-lg-12" id="receipt_timer_setting" help="Use this project for auto-provisioned tasks when starting timer on receipts.">
                    <field name="is_receipt_timer_project"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
