<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_account_internal_transfer_engine_form" model="ir.ui.view">
            <field name="name">account.internal.transfer.engine.form</field>
            <field name="model">account.internal.transfer.engine</field>
            <field name="arch" type="xml">
                <form string="Internal Transfer Engine">
                    <header>
                        <button name="action_confirm" string="Confirm" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="company_id" invisible="1"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="source_journal_id" readonly="state != 'draft'"/>
                                <field name="destination_journal_id" readonly="state != 'draft'"/>
                                <field name="transit_account_id" readonly="state != 'draft'"/>
                            </group>
                            <group>
                                <field name="amount" readonly="state != 'draft'"/>
                                <field name="date" readonly="state != 'draft'"/>
                                <field name="memo" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Journal Entries" name="journal_entries" invisible="not move_ids">
                                <field name="move_ids" readonly="1"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_account_internal_transfer_engine_tree" model="ir.ui.view">
            <field name="name">account.internal.transfer.engine.tree</field>
            <field name="model">account.internal.transfer.engine</field>
            <field name="arch" type="xml">
                <list string="Internal Transfers">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="source_journal_id"/>
                    <field name="destination_journal_id"/>
                    <field name="amount"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirm'" decoration-muted="state == 'cancel'"/>
                </list>
            </field>
        </record>

        <!-- Action -->
        <record id="action_account_internal_transfer_engine" model="ir.actions.act_window">
            <field name="name">Internal Transfers (Engine)</field>
            <field name="res_model">account.internal.transfer.engine</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
              <p class="o_view_nocontent_smiling_face">
                Create a new Internal Transfer
              </p><p>
                Move funds between two bank/cash journals by automatically generating a balanced pair of journal entries through a transit account.
              </p>
            </field>
        </record>

        <!-- Menuitem -->
        <menuitem id="menu_account_internal_transfer_engine" 
                  name="Internal Transfers" 
                  parent="account.account_transactions_menu" 
                  action="action_account_internal_transfer_engine" 
                  sequence="20"/>
    </data>
</odoo>
