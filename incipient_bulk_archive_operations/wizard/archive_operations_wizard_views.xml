<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Wizard Form View -->
        <record id="view_archive_operations_wizard_form" model="ir.ui.view">
            <field name="name">mrp.routing.archive.wizard.form</field>
            <field name="model">mrp.routing.archive.wizard</field>
            <field name="arch" type="xml">
                <form string="Archive Operations &amp; Cleanup Orphans">
                    <div class="alert alert-warning" role="alert">
                        <strong>Warning:</strong> Archiving these routing operations will also automatically archive any associated Quality Control Points to prevent orphans.
                    </div>
                    <group>
                        <field name="operation_ids" widget="many2many_tags" readonly="1"/>
                    </group>
                    <footer>
                        <button string="Confirm Archive" name="action_archive_and_cleanup" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Action to open the wizard from mrp.routing.workcenter list view -->
        <record id="action_archive_operations_wizard" model="ir.actions.act_window">
            <field name="name">Archive &amp; Cleanup Orphans</field>
            <field name="res_model">mrp.routing.archive.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="binding_model_id" ref="mrp.model_mrp_routing_workcenter"/>
            <field name="binding_view_types">list</field>
        </record>
    </data>
</odoo>
