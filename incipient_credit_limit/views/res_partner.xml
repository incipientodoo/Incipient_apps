<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_partner_form_inherit_sale_credit_limit" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.sale.credit.limit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="incipient_contact_customization.view_partner_form_inherit_customer_config"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='customer_number']" position="before">
                <field name="credit_limit"/>
            </xpath>
        </field>
    </record>

</odoo>