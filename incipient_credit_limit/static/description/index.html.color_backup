        <!-- VISUAL WALKTHROUGH -->
        <section id="walkthrough" class="p-4 p-md-5">
            <div class="text-center mb-5">
                <span class="badge bg-dark text-white px-3 py-1.5 rounded-pill fw-bold mb-2">INTERFACE SHOWCASE</span>
                <h3 class="h2 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">Complete Operational Workflow & Use Cases</h3>
                <p class="text-muted">End-to-end visual breakdown of Credit Limits, Overdue Locks, Managerial Overrides & Auto-Releases</p>
            </div>

            <!-- Step 1 (Text Left, Image Right) -->
            <div class="row align-items-center g-4 mb-5 pb-5 border-bottom">
                <div class="col-lg-5">
                    <span class="px-3 py-1 rounded-pill bg-danger text-white fw-bold small mb-2 d-inline-block">Step 01</span>
                    <h4 class="h3 fw-bold text-dark mb-3" style="font-family: 'Outfit', sans-serif;">Partner Credit Limit & AR Threshold Setup</h4>
                    <p class="text-secondary mb-3" style="line-height: 1.6;">Open any customer profile in Contacts (<code>res.partner</code>) and access the Invoicing tab to establish custom credit limits and financial risk parameters.</p>
                    <p class="text-secondary small mb-0" style="line-height: 1.6;">Set custom monetary threshold limits while the system continuously tracks live Accounts Receivable exposure and past-due invoice balances in real time.</p>
                </div>
                <div class="col-lg-7">
                    <div class="p-2 bg-white rounded-4 border shadow-sm">
                        <img src="1.png" alt="Partner Credit Limit Setup" class="img-fluid rounded-3 w-100" onerror="this.onerror=null; this.src='incipient-corp.png';">
                    </div>
                </div>
            </div>

            <!-- Step 2 (Image Left, Text Right) -->
            <div class="row align-items-center g-4 mb-5 pb-5 border-bottom flex-lg-row-reverse">
                <div class="col-lg-5">
                    <span class="px-3 py-1 rounded-pill bg-danger text-white fw-bold small mb-2 d-inline-block">Step 02</span>
                    <h4 class="h3 fw-bold text-dark mb-3" style="font-family: 'Outfit', sans-serif;">Quotation Past-Due Balance Auto-Intercept</h4>
                    <p class="text-secondary mb-3" style="line-height: 1.6;">When a sales representative creates a new quotation, the system instantly evaluates the customer's payment history for existing past-due balances.</p>
                    <p class="text-secondary small mb-0" style="line-height: 1.6;">If an unpaid past-due invoice is detected, the order is automatically placed on Credit Hold (<code>is_credit_hold = True</code>) with an alert logged directly to the Chatter feed.</p>
                </div>
                <div class="col-lg-7">
                    <div class="p-2 bg-white rounded-4 border shadow-sm">
                        <img src="2.png" alt="Quotation Past-Due Balance Auto-Intercept" class="img-fluid rounded-3 w-100" onerror="this.onerror=null; this.src='incipient-corp.png';">
                    </div>
                </div>
            </div>

            <!-- Step 3 (Text Left, Image Right) -->
            <div class="row align-items-center g-4 mb-5 pb-5 border-bottom">
                <div class="col-lg-5">
                    <span class="px-3 py-1 rounded-pill bg-danger text-white fw-bold small mb-2 d-inline-block">Step 03</span>
                    <h4 class="h3 fw-bold text-dark mb-3" style="font-family: 'Outfit', sans-serif;">Accounting Settlement & Automated Hold Clearance</h4>
                    <p class="text-secondary mb-3" style="line-height: 1.6;">Finance teams can view open customer invoices in Accounting and register payments to settle overdue balances.</p>
                    <p class="text-secondary small mb-0" style="line-height: 1.6;">Upon payment posting, the system automatically re-evaluates the customer's account status, clears the Credit Hold, and posts a confirmation update to the sales order Chatter.</p>
                </div>
                <div class="col-lg-7">
                    <div class="p-2 bg-white rounded-4 border shadow-sm">
                        <img src="3.png" alt="Accounting Settlement & Automated Hold Clearance" class="img-fluid rounded-3 w-100" onerror="this.onerror=null; this.src='incipient-corp.png';">
                    </div>
                </div>
            </div>

            <!-- Step 4 (Image Left, Text Right) -->
            <div class="row align-items-center g-4 mb-5 pb-5 border-bottom flex-lg-row-reverse">
                <div class="col-lg-5">
                    <span class="px-3 py-1 rounded-pill bg-danger text-white fw-bold small mb-2 d-inline-block">Step 04</span>
                    <h4 class="h3 fw-bold text-dark mb-3" style="font-family: 'Outfit', sans-serif;">Over-Limit Quotation Flagging & Confirmation Lock</h4>
                    <p class="text-secondary mb-3" style="line-height: 1.6;">Creating an order that exceeds the customer's defined credit limit automatically triggers an over-limit warning flag.</p>
                    <p class="text-secondary small mb-0" style="line-height: 1.6;">Sales reps attempting to click 'Confirm' are blocked by a system <code>UserError</code> dialog, keeping the order safely locked in Draft status until authorized release.</p>
                </div>
                <div class="col-lg-7">
                    <div class="p-2 bg-white rounded-4 border shadow-sm">
                        <img src="4.png" alt="Over-Limit Quotation Flagging & Confirmation Lock" class="img-fluid rounded-3 w-100" onerror="this.onerror=null; this.src='incipient-corp.png';">
                    </div>
                </div>
            </div>

            <!-- Step 5 (Text Left, Image Right) -->
            <div class="row align-items-center g-4 mb-5 pb-5 border-bottom">
                <div class="col-lg-5">
                    <span class="px-3 py-1 rounded-pill bg-danger text-white fw-bold small mb-2 d-inline-block">Step 05</span>
                    <h4 class="h3 fw-bold text-dark mb-3" style="font-family: 'Outfit', sans-serif;">Credit Hold Orders Centralized List View</h4>
                    <p class="text-secondary mb-3" style="line-height: 1.6;">Credit Managers can monitor all blocked sales orders across the organization via the dedicated 'Credit Hold' menu under Sales &rarr; Orders.</p>
                    <p class="text-secondary small mb-0" style="line-height: 1.6;">The centralized list view filters all active orders currently on hold, displaying live totals, order dates, customer risk standing, and quick access to managerial release actions.</p>
                </div>
                <div class="col-lg-7">
                    <div class="p-2 bg-white rounded-4 border shadow-sm">
                        <img src="5.png" alt="Credit Hold Orders Centralized List View" class="img-fluid rounded-3 w-100" onerror="this.onerror=null; this.src='incipient-corp.png';">
                    </div>
                </div>
            </div>

            <!-- Step 6 (Image Left, Text Right) -->
            <div class="row align-items-center g-4 mb-5 pb-5 border-bottom flex-lg-row-reverse">
                <div class="col-lg-5">
                    <span class="px-3 py-1 rounded-pill bg-danger text-white fw-bold small mb-2 d-inline-block">Step 06</span>
                    <h4 class="h3 fw-bold text-dark mb-3" style="font-family: 'Outfit', sans-serif;">Managerial Credit Release Wizard & Audit Trail</h4>
                    <p class="text-secondary mb-3" style="line-height: 1.6;">Authorized Credit Managers can launch the 'Release Credit Hold' smart action button on blocked quotations to review risk factors.</p>
                    <p class="text-secondary small mb-0" style="line-height: 1.6;">Submitting the wizard with a mandatory justification note clears the credit hold flag and writes a permanent audit log with the manager's sign-off to the Chatter.</p>
                </div>
                <div class="col-lg-7">
                    <div class="p-2 bg-white rounded-4 border shadow-sm">
                        <img src="6.png" alt="Managerial Credit Release Wizard & Audit Trail" class="img-fluid rounded-3 w-100" onerror="this.onerror=null; this.src='incipient-corp.png';">
                    </div>
                </div>
            </div>

            <!-- Step 7 (Text Left, Image Right) -->
            <div class="row align-items-center g-4 mb-5 pb-5 border-bottom">
                <div class="col-lg-5">
                    <span class="px-3 py-1 rounded-pill bg-danger text-white fw-bold small mb-2 d-inline-block">Step 07</span>
                    <h4 class="h3 fw-bold text-dark mb-3" style="font-family: 'Outfit', sans-serif;">Order Confirmation & Outgoing Delivery Generation</h4>
                    <p class="text-secondary mb-3" style="line-height: 1.6;">Once the credit hold is released by management, sales representatives can seamlessly confirm the quotation into an active Sale Order.</p>
                    <p class="text-secondary small mb-0" style="line-height: 1.6;">The order state updates to <code>Sale Order</code> and automatically provisions an outgoing Delivery Order (<code>stock.picking</code>) for warehouse picking and fulfillment.</p>
                </div>
                <div class="col-lg-7">
                    <div class="p-2 bg-white rounded-4 border shadow-sm">
                        <img src="7.png" alt="Order Confirmation & Outgoing Delivery Generation" class="img-fluid rounded-3 w-100" onerror="this.onerror=null; this.src='incipient-corp.png';">
                    </div>
                </div>
            </div>

            <!-- Step 8 (Image Left, Text Right) -->
            <div class="row align-items-center g-4 mb-5 pb-5 border-bottom flex-lg-row-reverse">
                <div class="col-lg-5">
                    <span class="px-3 py-1 rounded-pill bg-danger text-white fw-bold small mb-2 d-inline-block">Step 08</span>
                    <h4 class="h3 fw-bold text-dark mb-3" style="font-family: 'Outfit', sans-serif;">Warehouse Outgoing Delivery Shipping Intercept</h4>
                    <p class="text-secondary mb-3" style="line-height: 1.6;">When storekeepers attempt to validate an outgoing shipment in Inventory, the system performs a live Accounts Receivable credit check against customer standing.</p>
                    <p class="text-secondary small mb-0" style="line-height: 1.6;">If unpaid past-due invoices or exceeded limits remain at dispatch, shipping is blocked with an explicit <code>UserError</code> popup to prevent bad debt dispatch.</p>
                </div>
                <div class="col-lg-7">
                    <div class="p-2 bg-white rounded-4 border shadow-sm">
                        <img src="8.png" alt="Warehouse Outgoing Delivery Shipping Intercept" class="img-fluid rounded-3 w-100" onerror="this.onerror=null; this.src='incipient-corp.png';">
                    </div>
                </div>
            </div>

            <!-- Step 9 (Text Left, Image Right) -->
            <div class="row align-items-center g-4">
                <div class="col-lg-5">
                    <span class="px-3 py-1 rounded-pill bg-danger text-white fw-bold small mb-2 d-inline-block">Step 09</span>
                    <h4 class="h3 fw-bold text-dark mb-3" style="font-family: 'Outfit', sans-serif;">Final Payment Settlement & Successful Delivery Validation</h4>
                    <p class="text-secondary mb-3" style="line-height: 1.6;">Once the customer registers final payment with the accounting team, the storekeeper re-opens the pending Delivery Order in Inventory.</p>
                    <p class="text-secondary small mb-0" style="line-height: 1.6;">Clicking 'Validate' succeeds instantly without errors, allowing goods to be dispatched and transitioning the shipment to <code>Done</code> status.</p>
                </div>
                <div class="col-lg-7">
                    <div class="p-2 bg-white rounded-4 border shadow-sm">
                        <img src="9.png" alt="Final Payment Settlement & Successful Delivery Validation" class="img-fluid rounded-3 w-100" onerror="this.onerror=null; this.src='incipient-corp.png';">
                    </div>
                </div>
            </div>
        </section>

        <!-- EXPANDED 10 FAQ ACCORDION ITEMS -->
        <section id="faq" class="p-4 p-md-5 bg-light border-top">
            <div class="text-center mb-5">
                <h3 class="h2 fw-bold text-dark" style="font-family: 'Outfit', sans-serif;">Frequently Asked Questions
                </h3>
                <p class="text-muted">Detailed answers to top 10 queries regarding credit controls and setup</p>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-10">
                    <div class="accordion accordion-flush border rounded-4 p-3 bg-white shadow-sm" id="faqAccordion">

                        <!-- FAQ 1 -->
                        <div class="accordion-item border rounded-3 mb-3 bg-white">
                            <h2 class="accordion-header">
                                <button class="accordion-button fw-bold text-dark bg-white rounded-3 fs-6" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#faq1">
                                    1. How does the module calculate total customer credit exposure in real time?
                                </button>
                            </h2>
                            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-secondary" style="line-height: 1.6;">
                                    Total credit exposure dynamically sums unpaid posted invoices, draft customer bills,
                                    and un-invoiced confirmed sales orders for the partner account.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 2 -->
                        <div class="accordion-item border rounded-3 mb-3 bg-white">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold text-dark bg-white rounded-3 fs-6"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                                    2. Does the module block stock picking delivery orders when credit limit is
                                    exceeded?
                                </button>
                            </h2>
                            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-secondary" style="line-height: 1.6;">
                                    Yes! When an order is placed on Credit Hold state, any generated stock picking
                                    delivery order is automatically intercepted and locked until an authorized manager
                                    releases the credit hold.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 3 -->
                        <div class="accordion-item border rounded-3 mb-3 bg-white">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold text-dark bg-white rounded-3 fs-6"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq3">
                                    3. Who has permission to launch the 'Release Credit Hold' override wizard?
                                </button>
                            </h2>
                            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-secondary" style="line-height: 1.6;">
                                    Only users belonging to the designated 'Credit Control Manager' security group can
                                    access the release wizard and approve credit overrides.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 4 -->
                        <div class="accordion-item border rounded-3 mb-3 bg-white">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold text-dark bg-white rounded-3 fs-6"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq4">
                                    4. Can specific trusted or VIP customers bypass credit limit checks?
                                </button>
                            </h2>
                            <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-secondary" style="line-height: 1.6;">
                                    Yes. You can leave the customer credit limit field blank or check the dedicated VIP
                                    bypass flag on partner records.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 5 -->
                        <div class="accordion-item border rounded-3 mb-3 bg-white">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold text-dark bg-white rounded-3 fs-6"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq5">
                                    5. How does payment and bank reconciliation automatically release overdue credit holds?
                                </button>
                            </h2>
                            <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-secondary" style="line-height: 1.6;">
                                    When an accountant reconciles a payment or bank statement line against an overdue invoice (transitioning invoice <code>payment_state</code> to Paid or In Payment), the module triggers <code>_auto_release_credit_holds()</code>. If the customer's total overdue balance clears and total exposure is within limits, all held sales orders are automatically unblocked with a chatter audit trail post.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 6 -->
                        <div class="accordion-item border rounded-3 mb-3 bg-white">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold text-dark bg-white rounded-3 fs-6"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq6">
                                    6. How are multi-currency sales orders evaluated against customer credit limits?
                                </button>
                            </h2>
                            <div id="faq6" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-secondary" style="line-height: 1.6;">
                                    The system automatically converts foreign currency order totals into the main
                                    company currency using active Odoo exchange rates before evaluating the credit
                                    threshold.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 7 -->
                        <div class="accordion-item border rounded-3 mb-3 bg-white">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold text-dark bg-white rounded-3 fs-6"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq7">
                                    7. Is every credit hold trigger and manager override logged in the chatter feed?
                                </button>
                            </h2>
                            <div id="faq7" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-secondary" style="line-height: 1.6;">
                                    Yes. Every automated block, manager override, timestamp, user ID, and approval note
                                    is permanently logged to the sales order chatter feed.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 8 -->
                        <div class="accordion-item border rounded-3 mb-3 bg-white">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold text-dark bg-white rounded-3 fs-6"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq8">
                                    8. Is this module compatible with Community Edition, Enterprise Edition, and
                                    Odoo.sh?
                                </button>
                            </h2>
                            <div id="faq8" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-secondary" style="line-height: 1.6;">
                                    Yes! It is 100% compatible across Community, Enterprise, and Odoo.sh cloud
                                    environments.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 9 -->
                        <div class="accordion-item border rounded-3 mb-3 bg-white">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold text-dark bg-white rounded-3 fs-6"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq9">
                                    9. Will installing this module impact existing sales orders or historical data?
                                </button>
                            </h2>
                            <div id="faq9" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-secondary" style="line-height: 1.6;">
                                    No. Historical confirmed sales orders remain unchanged. Credit limit validation only
                                    triggers when confirming new quotations or editing active orders.
                                </div>
                            </div>
                        </div>

                        <!-- FAQ 10 -->
                        <div class="accordion-item border rounded-3 bg-white">
                            <h2 class="accordion-header">
                                <button class="accordion-button collapsed fw-bold text-dark bg-white rounded-3 fs-6"
                                    type="button" data-bs-toggle="collapse" data-bs-target="#faq10">
                                    10. What kind of technical support is included with my purchase?
                                </button>
                            </h2>
                            <div id="faq10" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                                <div class="accordion-body text-secondary" style="line-height: 1.6;">
                                    Every purchase includes lifetime free technical support for configuration assistance
                                    and version bug fixes via <a href="mailto:hello@incipientcorp.com"
                                        class="text-dark fw-bold">hello@incipientcorp.com</a>.
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </section>

        <!-- SERVICE TRUST & CONTACT CARDS -->
        <section id="support" class="p-4 p-md-5 bg-white border-top">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="p-4 bg-light rounded-4 border text-center h-100 shadow-sm">
                        <div class="h3 mb-2">🌐</div>
