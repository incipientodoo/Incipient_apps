<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_credit_release_form" model="ir.ui.view">
        <field name="name">wizard.credit.release.form</field>
        <field name="model">wizard.credit.release</field>
        <field name="arch" type="xml">
            <form string="Release Credit Hold">
                <group>
                    <field name="order_id" invisible="1"/>
                    <field name="reason" placeholder="Enter reason for releasing credit hold..."/>
                </group>
                <footer>
                    <button string="Release Order" name="action_release" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
