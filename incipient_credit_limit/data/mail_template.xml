<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="mail_template_credit_hold_notification" model="mail.template">
            <field name="name">Sale Order: Credit Hold Notification</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">⚠️ Credit Hold – {{ object.partner_id.name }} exceeded credit limit</field>
            <field name="email_from">{{ object.company_id.email or user.email }}</field>
            <field name="email_to">{{
                ','.join([
                    u.email for u in
                    object.env['res.users'].search([
                        ('groups_id', 'in', [
                            object.env.ref('sales_team.group_sale_manager').id,
                            object.env.ref('account.group_account_manager').id
                        ])
                    ])
                    if u.email
                ])
            }}</field>
            <field name="body_html" type="html">
                <div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;">
                    <h2 style="background:#c0392b;color:#fff;padding:16px 20px;margin:0;">
                        ⚠️ Credit Hold Alert
                    </h2>
                    <div style="padding:20px;border:1px solid #ddd;">
                        <p>The following quotation has been moved to <strong>Credit Hold</strong>:</p>
                        <table style="width:100%;border-collapse:collapse;font-size:14px;">
                            <tr style="background:#f5f5f5;">
                                <td style="padding:8px 12px;border:1px solid #ddd;font-weight:bold;">Customer</td>
                                <td style="padding:8px 12px;border:1px solid #ddd;">{{ object.partner_id.name }}</td>
                            </tr>
                            <tr>
                                <td style="padding:8px 12px;border:1px solid #ddd;font-weight:bold;">Quotation</td>
                                <td style="padding:8px 12px;border:1px solid #ddd;">{{ object.name }}</td>
                            </tr>
                            <tr style="background:#f5f5f5;">
                                <td style="padding:8px 12px;border:1px solid #ddd;font-weight:bold;">Order Amount</td>
                                <td style="padding:8px 12px;border:1px solid #ddd;">
                                    {{ '{:,.2f}'.format(object.amount_total) }}
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:8px 12px;border:1px solid #ddd;font-weight:bold;color:#c0392b;">
                                    Credit Limit
                                </td>
                                <td style="padding:8px 12px;border:1px solid #ddd;color:#c0392b;font-weight:bold;">
                                    {{ '{:,.2f}'.format(object.partner_id.credit_limit) }}
                                </td>
                            </tr>
                        </table>
                        <p style="margin-top:20px;">
                            Please go to <strong>Sales &gt; Credit Hold</strong> and click
                            <strong>Release</strong> to approve this order.
                        </p>
                    </div>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>