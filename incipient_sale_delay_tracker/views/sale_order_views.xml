<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_delay_tracker" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.delay.tracker</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_shipping']" position="inside">
                <field name="reason_for_delay" readonly="0"/>
            </xpath>
        </field>
    </record>
</odoo>
