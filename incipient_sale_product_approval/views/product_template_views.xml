<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_dual_approval" model="ir.ui.view">
        <field name="name">product.template.form.dual.approval</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']" position="inside">
                <group name="approval_gate_settings" string="Dual Approval Gate Requirements">
                    <group>
                        <field name="require_customer_approval"/>
                        <field name="require_manager_approval"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
