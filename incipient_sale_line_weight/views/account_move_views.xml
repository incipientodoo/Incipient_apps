<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_weight" model="ir.ui.view">
        <field name="name">account.move.form.weight</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <!-- Add unit_weight and ext_weight to invoice lines -->
            <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='invoice_tab']/field[@name='invoice_line_ids']/list[1]/field[@name='quantity']" position="after">
                <field name="unit_weight" readonly="1" optional="show"/>
                <field name="ext_weight" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
