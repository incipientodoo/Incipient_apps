<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_weight" model="ir.ui.view">
        <field name="name">sale.order.form.weight</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add unit_weight and ext_weight to order lines -->
            <xpath expr="//notebook/page[@name='order_lines']/field[@name='order_line']/list/field[@name='product_uom_qty']" position="after">
                <field name="unit_weight" readonly="1" optional="show"/>
                <field name="ext_weight" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
