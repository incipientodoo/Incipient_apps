<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_customer_config" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.customer.configuration</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="customer_configuration" string="Customer Configuration">
                    <group>
                        <group>
                            <field name="customer_number"/>
                            <field name="network_account"/>
                            <field name="dedicated_network_account_number"/>
                            <field name="acc_number" invisible="supplier_rank != True"/>
                            <field name="max_date" invisible="supplier_rank != True"/>
                            <field name="dollar_ytd" invisible="supplier_rank != True"/>
                            <field name="discount" invisible="supplier_rank != True"/>
                            <field name="days" invisible="supplier_rank != True"/>
                            <field name="net" invisible="supplier_rank != True"/>
                        </group>
                        <group>
                            <field name="discount_2" invisible="supplier_rank != True"/>
                            <field name="days_2" invisible="supplier_rank != True"/>
                            <field name="net_2" invisible="supplier_rank != True"/>
                            <field name="payment_term" invisible="supplier_rank != True"/>
                            <field name="default_ap_gl" invisible="supplier_rank != True"/>
                            <field name="last_pay" invisible="supplier_rank != True"/>
                            <field name="default_gl" invisible="supplier_rank != True"/>
                            <field name="zip_4" invisible="supplier_rank != True"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='property_product_pricelist']" position="after">
                <field name="cost_level"/>
                <field name="cost_markup_percentage" invisible="cost_level != 'custom'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_discretionary_prices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-money"
                        invisible="customer_rank == 0">
                    <field name="discretionary_price_count" widget="statinfo" string="Price Overrides"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>