<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="discretionary_price_list_view" model="ir.ui.view">
        <field name="name">discretionary.price.list</field>
        <field name="model">discretionary.price</field>
        <field name="arch" type="xml">
            <list string="Price Overrides" decoration-danger="is_expired == True">
                <field name="customer_id"/>
                <field name="product_id"/>
                <field name="vendor_id"/>
                <field name="source_type"/>
                <field name="override_cost"/>
                <field name="resale_price"/>
                <field name="expiration_date"/>
                <field name="is_expired"/>
                <field name="contract_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="discretionary_price_form_view" model="ir.ui.view">
        <field name="name">discretionary.price.form</field>
        <field name="model">discretionary.price</field>
        <field name="arch" type="xml">
            <form string="Price Override">
                <sheet>
                    <group>
                        <group>
                            <field name="customer_id"/>
                            <field name="product_id"/>
                            <field name="vendor_id"/>
                            <field name="source_type"/>
                            <field name="contract_id" invisible="source_type != 'contract'"/>
                        </group>
                        <group>
                            <field name="override_cost"/>
                            <field name="resale_price"/>
                            <field name="expiration_date"/>
                            <field name="is_expired"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_discretionary_price" model="ir.actions.act_window">
        <field name="name">Price Overrides</field>
        <field name="res_model">discretionary.price</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_not_expired': 1}</field>
    </record>

</odoo>