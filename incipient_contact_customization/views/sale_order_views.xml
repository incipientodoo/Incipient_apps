<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_form_inherit_contract" model="ir.ui.view">
        <field name="name">sale.order.form.contract</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_unit']" position="after">
                <field name="price_source" optional="show" readonly="1"/>
                <field name="override_cost" optional="hide" readonly="1"/>
                <field name="cost_expiration_date" optional="hide" readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="view_sale_order_form_inherit_contract" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.customer.contract</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="customer_contract_id"
                       options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>

</odoo>