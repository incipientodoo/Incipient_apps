<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customer_contract_line_tree" model="ir.ui.view">
        <field name="name">customer.contract.line.tree</field>
        <field name="model">customer.contract.line</field>
        <field name="arch" type="xml">
            <list string="Contract Lines" editable="bottom">
                <field name="product_id"/>
                <field name="cost_price"/>
            </list>
        </field>
    </record>

    <record id="view_customer_contract_line_form" model="ir.ui.view">
        <field name="name">customer.contract.line.form</field>
        <field name="model">customer.contract.line</field>
        <field name="arch" type="xml">
            <form string="Contract Line">
                <group>
                    <field name="product_id"/>
                    <field name="cost_price"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_customer_contract_form" model="ir.ui.view">
        <field name="name">customer.contract.form</field>
        <field name="model">customer.contract</field>
        <field name="arch" type="xml">
            <form string="Customer Contract">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_expire" string="Expire"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('expired', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object"
                            invisible="state not in ('cancelled', 'expired')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="source"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contract Lines" name="lines">
                            <field name="line_ids" widget="one2many"/>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_customer_contract_tree" model="ir.ui.view">
        <field name="name">customer.contract.tree</field>
        <field name="model">customer.contract</field>
        <field name="arch" type="xml">
            <list string="Customer Contracts"
                  decoration-success="state == 'active'"
                  decoration-muted="state in ('expired', 'cancelled')">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="source"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="line_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'draft'"
                       decoration-danger="state == 'cancelled'"
                       decoration-warning="state == 'expired'"/>
            </list>
        </field>
    </record>

    <record id="action_customer_contract" model="ir.actions.act_window">
        <field name="name">Customer Contracts</field>
        <field name="res_model">customer.contract</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Customer Contract
            </p>
        </field>
    </record>

    <menuitem id="menu_customer_contract_list"
              name="Customer Contracts"
              parent="sale.sale_order_menu"
              action="action_customer_contract"
                sequence="100"/>

</odoo>