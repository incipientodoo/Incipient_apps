<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="customer_division_view_form" model="ir.ui.view">
        <field name="name">customer.division.view.form</field>
        <field name="model">customer.division</field>
        <field name="arch" type="xml">
            <form string="Customer Division">
                <sheet>
                    <group>
                        <group>
                            <field name="div_code"/>
                            <field name="div_name"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="customer_division_view_list" model="ir.ui.view">
        <field name="name">customer.division.view.list</field>
        <field name="model">customer.division</field>
        <field name="arch" type="xml">
            <list string="Customer Divisions">
                <field name="div_code"/>
                <field name="div_name"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_customer_division" model="ir.actions.act_window">
        <field name="name">Customer Divisions</field>
        <field name="res_model">customer.division</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu under Sale > Configuration -->
    <menuitem
        id="menu_customer_division"
        name="Customer Divisions"
        parent="sale.menu_sale_config"
        action="action_customer_division"/>

</odoo>