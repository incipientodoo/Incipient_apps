<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="vendor_contract_list_view" model="ir.ui.view">
        <field name="name">vendor.contract.list</field>
        <field name="model">vendor.contract</field>
        <field name="arch" type="xml">
            <list string="Vendor Contracts" decoration-danger="state=='expired'" decoration-muted="state=='cancelled'">
                <field name="name"/>
                <field name="vendor_id"/>
                <field name="source"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="line_count" string="Items"/>
                <field name="state" widget="badge"
                       decoration-success="state=='active'"
                       decoration-info="state=='draft'"
                       decoration-danger="state=='expired'"
                       decoration-warning="state=='cancelled'"/>
            </list>
        </field>
    </record>

    <record id="vendor_contract_form_view" model="ir.ui.view">
        <field name="name">vendor.contract.form</field>
        <field name="model">vendor.contract</field>
        <field name="arch" type="xml">
            <form string="Vendor Contract">
                <header>
                    <button name="action_activate" string="Activate"
                            type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_expire" string="Mark Expired"
                            type="object"
                            invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel"
                            type="object"
                            invisible="state in ('expired', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft"
                            type="object"
                            invisible="state not in ('cancelled', 'expired')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="vendor_id"/>
                            <field name="source"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="line_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Contract Lines" name="lines">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="contract_net_cost"/>
                                    <field name="fifo_cost"/>
                                    <field name="rebate_amount"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>


    <record id="action_vendor_contract" model="ir.actions.act_window">
        <field name="name">Vendor Contracts</field>
        <field name="res_model">vendor.contract</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>