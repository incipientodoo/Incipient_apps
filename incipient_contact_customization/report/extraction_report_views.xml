<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="extraction_line_list_view" model="ir.ui.view">
        <field name="name">extraction.report.line.list</field>
        <field name="model">extraction.report.line</field>
        <field name="arch" type="xml">
            <list string="Extraction Report">
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="vendor_id"/>
                <field name="customer_id"/>
                <field name="product_id"/>
                <field name="contract_id"/>
                <field name="qty_sold" sum="Total Qty"/>
                <field name="fifo_cost"/>
                <field name="contract_net_cost"/>
                <field name="rebate_per_unit"/>
                <field name="total_rebate" sum="Total Rebate"/>
                <field name="sale_order_id" optional="hide"/>
                <field name="invoice_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="extraction_line_pivot_view" model="ir.ui.view">
        <field name="name">extraction.report.line.pivot</field>
        <field name="model">extraction.report.line</field>
        <field name="arch" type="xml">
            <pivot string="Extraction Analysis">
                <field name="vendor_id" type="row"/>
                <field name="customer_id" type="row"/>
                <field name="product_id" type="row"/>
                <field name="total_rebate" type="measure"/>
                <field name="qty_sold" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="extraction_line_graph_view" model="ir.ui.view">
        <field name="name">extraction.report.line.graph</field>
        <field name="model">extraction.report.line</field>
        <field name="arch" type="xml">
            <graph string="Extraction Report" type="bar">
                <field name="vendor_id"/>
                <field name="total_rebate" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_extraction_lines" model="ir.actions.act_window">
        <field name="name">Extraction History</field>
        <field name="res_model">extraction.report.line</field>
        <field name="view_mode">list</field>
    </record>

</odoo>