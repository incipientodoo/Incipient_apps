<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_vendor_contract" model="ir.sequence">
            <field name="name">Vendor Contract</field>
            <field name="code">vendor.contract</field>
            <field name="prefix">VC/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_customer_contract" model="ir.sequence">
            <field name="name">Customer Contract</field>
            <field name="code">customer.contract</field>
            <field name="prefix">CUST/%(range_year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>